{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COM2USB",
  "mainBinaryName": "COM2USB",
  "version": "1.0.0",
  "identifier": "com.pluggor.com2usb",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "properties",
        "title": "COM2USB — Propriedades",
        "url": "index.html",
        "width": 560,
        "height": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "© 2026 PLUGGOR TECNOLOGIA LTDA",
    "licenseFile": "../LICENSE",
    "resources": ["icons/tray.png", "icons/tray-off.png"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
